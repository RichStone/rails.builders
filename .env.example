# Copy .env.example to .env, then replace these safe local defaults as needed.
RAILS_BUILDERS_OG_EMAILS=facilitator@example.com,og-builder@example.com
RAILS_BUILDERS_FACILITATOR_EMAIL=facilitator@example.com
APP_HOST=rails.builders
RESEND_API_KEY=
HONEYBADGER_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required by Kamal when deploying. KAMAL_BUILD_ARCH must match the server.
KAMAL_HOST=
KAMAL_BUILD_ARCH=
KAMAL_PROXY_SSL=false
KAMAL_IMAGE=richwhale/rails-builders
KAMAL_REGISTRY_SERVER=docker.io
KAMAL_REGISTRY_USERNAME=richwhale
KAMAL_REGISTRY_PASSWORD=
