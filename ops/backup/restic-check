#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

readonly PROGRAM="rails-builders-restic-check"

die() {
  printf '%s: ERROR: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

command -v flock >/dev/null 2>&1 || die "required command not found: flock"
command -v restic >/dev/null 2>&1 || die "required command not found: restic"
[[ -n "${RESTIC_REPOSITORY:-}" ]] || die "RESTIC_REPOSITORY must be set by the systemd EnvironmentFile"
[[ -n "${RESTIC_PASSWORD:-}" ]] || die "RESTIC_PASSWORD must be set by the systemd EnvironmentFile"

RESTIC_LOCK_FILE="${RESTIC_LOCK_FILE:-/run/lock/rails-builders-restic.lock}"
RESTIC_CACHE_DIR="${RESTIC_CACHE_DIR:-/var/cache/rails-builders-restic}"
RESTIC_CHECK_IN_URL="${RESTIC_CHECK_IN_URL:-}"
export RESTIC_CACHE_DIR

mkdir -p "$RESTIC_CACHE_DIR"
exec 9>"$RESTIC_LOCK_FILE"
flock --nonblock 9 || die "another backup, check, or restore drill is already running"

printf '%s: checking repository structure and snapshot metadata\n' "$PROGRAM"
restic check
if [[ -n "$RESTIC_CHECK_IN_URL" ]]; then
  command -v curl >/dev/null 2>&1 || die "required command not found: curl"
  curl --fail --silent --show-error --max-time 10 --output /dev/null "$RESTIC_CHECK_IN_URL"
fi
printf '%s: repository check completed successfully\n' "$PROGRAM"
