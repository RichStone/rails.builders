#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

readonly PROGRAM="rails-builders-monitoring-install"

die() {
  printf '%s: ERROR: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

((EUID == 0)) || die "run as root"

for command_name in docker install mktemp systemctl; do
  command -v "$command_name" >/dev/null 2>&1 || die "required command not found: $command_name"
done

source_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
environment_file="/etc/rails-builders/monitoring"

if [[ ! -e "$environment_file" ]]; then
  [[ -n "${HONEYBADGER_API_KEY:-}" ]] || die "HONEYBADGER_API_KEY is required for the first install"
  [[ "$HONEYBADGER_API_KEY" =~ ^[[:alnum:]_-]+$ ]] || die "HONEYBADGER_API_KEY has an unsupported format"
  install -d -m 0755 /etc/rails-builders
  install -m 0600 /dev/null "$environment_file"
  printf 'HONEYBADGER_API_KEY=%s\n' "$HONEYBADGER_API_KEY" >"$environment_file"
fi
chmod 0600 "$environment_file"
unset HONEYBADGER_API_KEY

download_dir="$(mktemp -d "${TMPDIR:-/tmp}/rails-builders-monitoring.XXXXXX")"
cleanup() {
  if [[ -d "$download_dir" && "$download_dir" == "${TMPDIR:-/tmp}/rails-builders-monitoring."* ]]; then
    rm -rf -- "$download_dir"
  fi
}
trap cleanup EXIT

docker buildx build --pull --output "type=local,dest=$download_dir" "$source_dir"
install -m 0755 "$download_dir/hb" /usr/local/bin/hb
install -m 0644 "$source_dir/rails-builders-host-metrics.service" \
  /etc/systemd/system/rails-builders-host-metrics.service

systemctl daemon-reload
systemctl enable rails-builders-host-metrics.service
systemctl restart rails-builders-host-metrics.service

printf '%s: Honeybadger host metrics enabled\n' "$PROGRAM"
/usr/local/bin/hb --version
