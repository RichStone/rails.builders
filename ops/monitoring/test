#!/usr/bin/env bash

set -Eeuo pipefail

source_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
installer="$source_dir/install"
unit="$source_dir/rails-builders-host-metrics.service"
hetzner_status="$source_dir/hetzner-status"
token_store="$source_dir/store-hetzner-token"

bash -n "$installer"
bash -n "$token_store"
ruby "$source_dir/hetzner_status_test.rb"

grep -F 'EnvironmentFile=/etc/rails-builders/monitoring' "$unit" >/dev/null
grep -F 'DynamicUser=true' "$unit" >/dev/null
grep -F 'ExecStart=/usr/local/bin/hb agent --config /dev/null --tag environment=production --tag host=rails-builders-production' "$unit" >/dev/null
grep -F 'find-generic-password' "$hetzner_status" >/dev/null
grep -F 'rails-builders-hcloud-readonly' "$hetzner_status" >/dev/null
grep -F 'read -rsp' "$token_store" >/dev/null

printf 'monitoring smoke tests passed\n'
