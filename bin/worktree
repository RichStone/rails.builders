#!/usr/bin/env ruby

require "digest"
require "fileutils"
require "socket"

APP_ROOT = File.expand_path("..", __dir__)
ENV_FILE = File.join(APP_ROOT, ".worktree.env")
CHATGPT_ENVIRONMENT = File.join(APP_ROOT, ".codex/environments/environment.toml")
PORT_MIN = 3_100
PORT_COUNT = 20_000

def generated_environment
  return unless File.file?(ENV_FILE)

  File.foreach(ENV_FILE).each_with_object({}) do |line, values|
    key, value = line.strip.split("=", 2)
    values[key] = value if key&.match?(/\A[A-Z][A-Z0-9_]*\z/) && value
  end
end

def available_port?(port)
  server = TCPServer.new("127.0.0.1", port)
  true
rescue Errno::EADDRINUSE, Errno::EACCES
  false
ensure
  server&.close
end

def choose_port
  existing = generated_environment&.fetch("PORT", nil)&.to_i
  return existing if existing && existing.between?(PORT_MIN, PORT_MIN + PORT_COUNT - 1)

  offset = Digest::SHA256.hexdigest(File.realpath(APP_ROOT))[0, 8].to_i(16) % PORT_COUNT
  PORT_COUNT.times do |attempt|
    candidate = PORT_MIN + ((offset + attempt) % PORT_COUNT)
    return candidate if available_port?(candidate)
  end

  abort "No free development port found between #{PORT_MIN} and #{PORT_MIN + PORT_COUNT - 1}."
end

def write_environment
  port = choose_port
  worktree_id = Digest::SHA256.hexdigest(File.realpath(APP_ROOT))[0, 8]
  contents = <<~ENV
    # Generated by bin/worktree setup. Do not commit or edit by hand.
    PORT=#{port}
    PIDFILE=tmp/pids/server-#{port}.pid
    RAILS_BUILDERS_WORKTREE_ID=#{worktree_id}
  ENV

  temporary_file = "#{ENV_FILE}.#{Process.pid}.tmp"
  File.write(temporary_file, contents)
  File.rename(temporary_file, ENV_FILE)
  generated_environment
ensure
  FileUtils.rm_f(temporary_file) if temporary_file && File.exist?(temporary_file)
end

def apply_environment(values)
  values.each { |key, value| ENV[key] = value }
end

def run!(*command)
  system(*command, chdir: APP_ROOT, exception: true)
end

def configure_chatgpt(announce: true)
  run! "git", "config", "--worktree", "codex.localEnvironmentConfigPath", CHATGPT_ENVIRONMENT
  puts "ChatGPT environment selected: #{CHATGPT_ENVIRONMENT}" if announce
end

def secret_status
  if File.file?(File.join(APP_ROOT, ".env.development"))
    ".env.development available"
  else
    ".env.development not present (optional)"
  end
end

def process_running?(pid)
  Process.kill(0, pid)
  true
rescue Errno::ESRCH
  false
rescue Errno::EPERM
  true
end

def puma_process?(pid, port)
  command = IO.popen([ "ps", "-p", pid.to_s, "-o", "command=" ], &:read).strip
  command.include?("puma") && command.include?(port.to_s)
rescue Errno::ENOENT
  true
end

def server_pid(values)
  pid_file = File.join(APP_ROOT, values.fetch("PIDFILE"))
  return unless File.file?(pid_file)

  Integer(File.read(pid_file).strip, 10)
rescue ArgumentError
  FileUtils.rm_f(pid_file)
  nil
end

def stop_server(values)
  port = values.fetch("PORT")
  pid_file = File.join(APP_ROOT, values.fetch("PIDFILE"))
  pid = server_pid(values)

  unless pid && process_running?(pid)
    FileUtils.rm_f(pid_file)
    puts "Rails is already stopped on localhost:#{port}."
    return
  end

  abort "Refusing to stop PID #{pid}: it is not Puma on port #{port}." unless puma_process?(pid, port)

  Process.kill("TERM", pid)
  50.times do
    break unless process_running?(pid)

    sleep 0.1
  end

  abort "Puma did not stop within 5 seconds (PID #{pid})." if process_running?(pid)

  FileUtils.rm_f(pid_file)
  puts "Stopped Rails on http://localhost:#{port}."
end

def print_summary(values, setup: false)
  port = values.fetch("PORT")
  url = "http://localhost:#{port}"
  puts
  puts(setup ? "== Worktree setup complete ==" : "== Worktree details ==")
  puts "Worktree:      #{values.fetch("RAILS_BUILDERS_WORKTREE_ID")}"
  puts "Root:          #{APP_ROOT}"
  puts "URL:           #{url}"
  puts "Development DB: #{File.join(APP_ROOT, "storage/development.sqlite3")}"
  puts "Test DB:        #{File.join(APP_ROOT, "storage/test.sqlite3")}"
  puts "Uploads:        #{File.join(APP_ROOT, "storage")}"
  puts "Local config:   #{ENV_FILE}"
  puts "ChatGPT config: #{CHATGPT_ENVIRONMENT}"
  puts "Secrets:        #{secret_status}"
  if setup
    puts "Dependencies:   checked; missing gems installed"
    puts "Database:       created and migrated"
    puts "Logs/tmp:       cleared"
  end
  puts
  puts "Quick worktree commands"
  puts "  bin/worktree start  # start #{url}"
  puts "  bin/worktree stop   # stop this worktree's Rails server"
  puts "  bin/worktree info   # show this summary again"
  puts "  bin/worktree configure-chatgpt  # select the committed app config"
  puts "  bin/rails test      # run the test suite"
end

def setup
  values = write_environment
  apply_environment(values)

  puts "== Configuring isolated worktree =="
  puts "Port #{values.fetch("PORT")}; SQLite databases and uploads stay under this worktree."
  configure_chatgpt(announce: false)
  run! File.join(APP_ROOT, "bin/setup"), "--skip-server"
  print_summary(values, setup: true)
  values
end

case ARGV.shift || "info"
when "setup"
  setup
when "start"
  values = generated_environment || setup
  apply_environment(values)
  pid = server_pid(values)
  if pid && process_running?(pid)
    puts "Rails is already running at http://localhost:#{values.fetch("PORT")} (PID #{pid})."
    exit
  end
  puts "Starting Rails at http://localhost:#{values.fetch("PORT")}"
  STDOUT.flush
  Dir.chdir(APP_ROOT) { exec File.join(APP_ROOT, "bin/dev") }
when "stop"
  values = generated_environment
  abort "This checkout has not been configured yet. Run: bin/worktree setup" unless values

  stop_server(values)
when "info"
  values = generated_environment
  if values
    print_summary(values)
  else
    warn "This checkout has not been configured yet. Run: bin/worktree setup"
    exit 1
  end
when "configure-chatgpt"
  configure_chatgpt
when "cleanup"
  values = generated_environment
  stop_server(values) if values
  puts "Worktree cleanup complete."
  puts "No shared services were created; its databases, uploads, logs, and PID files are local to the worktree."
  puts "Configured URL was http://localhost:#{values.fetch("PORT")}" if values
else
  warn <<~USAGE
    Usage: bin/worktree [setup|start|stop|info|configure-chatgpt|cleanup]

      setup    Install dependencies, prepare the isolated database, and print a summary
      start    Start Rails on this worktree's assigned port
      stop     Stop this worktree's Rails server
      info     Show paths, URL, and quick commands
      configure-chatgpt  Select the committed environment without opening app settings
      cleanup  Describe the worktree-local resources removed with the checkout
  USAGE
  exit 1
end
