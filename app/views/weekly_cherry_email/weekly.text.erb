THE WEEKLY BUILDERS CHERRY
Session from <%= @session_date %>

<% if @warning_notice.present? %>
<%= @warning_notice %>

<% end %>
<% if @info_notice.present? %>
<%= @info_notice %>

<% end %>

Hey <%= @recipient_name %>,

<%= render "weekly_cherry_email/personal" %>

<% if @own_update || @other_updates.any? %>
<% if @own_update %>
Your TL;DR

<%= render "weekly_cherry_email/speaker_update", update: @own_update, own: true %>
<% end %>
<% if @other_updates.any? %>
Others' TL;DRs

<% @other_updates.each_with_index do |update, index| %>
<% unless index.zero? %>
────────────────────────

<% end %>
<%= render "weekly_cherry_email/speaker_update", update: update, own: false %>
<% end %>
<% end %>
<% elsif @tldr.any? %>
TL;DR
<% @tldr.each do |line| %>
<%= line %>
<% end %>
<% end %>

<% if @recommendations.any? %>
Recommendations & Mentions
<% @recommendations.each do |group| %>

<%= group.fetch(:title) %>
<% group.fetch(:links).each do |link| %>
<%= link.fetch(:label) %>: <%= link.fetch(:url) %>
<% end %>
<% end %>
<% end %>

<% if @attended %>
Review the last session -> <%= @session_url %>
<% end %>

<%= @next_time ? "The next session is on #{@next_time}." : "Next session time: to be confirmed." %>
<%= @next_meet_url ? "Google Meet: #{@next_meet_url}" : "The Google Meet link will be available on the session page." %>

<%= render "weekly_cherry_email/return_session" %>
Sincerely yours,
Rich and Otto Labot
