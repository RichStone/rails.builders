<% content_for :preheader, @attended ? "Your promise, feedback, and the highlights from this week." : "Catch up on the highlights from this week." %>
<h1 style="margin: 0 0 4px; color: #35040f; font-size: 22px; line-height: 30px;">The Weekly Builders Cherry</h1>
<p style="margin: 0 0 24px; color: #65575a; font-size: 14px; line-height: 21px;"><%= @session_date %></p>
<% if @warning_notice.present? %>
  <p data-edition-notice="warning" style="margin: 0 0 16px; padding: 10px 12px; background-color: #fff4ce; color: #614a0b;"><%= @warning_notice %></p>
<% end %>
<% if @info_notice.present? %>
  <p data-edition-notice="info" style="margin: 0 0 16px; padding: 10px 12px; background-color: #e8f2ff; color: #173b65;"><%= @info_notice %></p>
<% end %>
<p style="margin: 0 0 16px;">Hey <%= @recipient_name %>,</p>
<% if @promise.present? %>
  <h2 style="margin: 24px 0 8px; color: #35040f; font-size: 19px; line-height: 26px;"><%= @attended ? "Your promise until next session" : "Your promise from your last session" %></h2>
  <p style="margin: 0 0 16px;">You promised to <%= @promise.sub(/\A\p{Lu}(?=\p{Ll})/) { |initial| initial.downcase } %></p>
<% elsif @attended %>
  <p style="margin: 0 0 16px;">No explicit next-session promise was captured for you this week.</p>
<% end %>
<% if @attended %>
  <% if @feedback.any? || @mentions.any? %>
    <h2 style="margin: 24px 0 8px; color: #35040f; font-size: 19px; line-height: 26px;">Feedback and mentions</h2>
    <% @feedback.each do |item| %>
      <p style="margin: 0 0 12px;"><strong><%= item.fetch(:emoji) %> <%= item.fetch(:name) %> → you:</strong> <%= item.fetch(:body) %></p>
    <% end %>
    <% @mentions.each do |mention| %>
      <p style="margin: 0 0 12px;"><%= mention %></p>
    <% end %>
  <% end %>
<% else %>
  <p style="margin: 0 0 12px;"><%= @absence_warning %></p>
  <% if @mentions.any? || @feedback.any? %>
    <p style="margin: 0 0 8px;"><strong>The Builders said this about you this time:</strong></p>
    <% @mentions.each do |mention| %>
      <p style="margin: 0 0 12px;"><%= mention %></p>
    <% end %>
    <% @feedback.each do |item| %>
      <p style="margin: 0 0 12px;"><strong><%= item.fetch(:emoji) %> <%= item.fetch(:name) %>:</strong> <%= item.fetch(:body) %></p>
    <% end %>
  <% else %>
    <p style="margin: 0 0 12px;">The Builders didn't mention you this time.</p>
  <% end %>
<% end %>
<% if @tldr.any? %>
  <div data-tldr>
    <h2 style="margin: 32px 0 12px; color: #35040f; font-size: 19px; line-height: 26px;">TL;DR</h2>
    <% @tldr.each do |line| %>
      <p style="margin: 0 0 12px; color: #35292c; font-size: 17px; line-height: 27px;"><%= line %></p>
    <% end %>
  </div>
<% end %>
<% if @recommendations.any? %>
  <div data-recommendations>
    <h2 style="margin: 32px 0 12px; color: #35040f; font-size: 19px; line-height: 26px;">Recommendations &amp; Mentions</h2>
    <% @recommendations.each do |group| %>
      <h3 style="margin: 18px 0 4px; font-size: 16px; line-height: 24px;"><%= group.fetch(:title) %></h3>
      <% group.fetch(:links).each do |link| %>
        <p style="margin: 0 0 6px;"><a href="<%= link.fetch(:url) %>" style="color: #a40f32; text-decoration: underline;"><%= link.fetch(:label) %></a></p>
      <% end %>
    <% end %>
  </div>
<% end %>
<% if @attended %>
  <p style="margin: 24px 0 0;"><a href="<%= @session_url %>" style="color: #a40f32; font-weight: 700; text-decoration: underline;">Review the last session -&gt;</a></p>
<% end %>
<h2 style="margin: 32px 0 8px; color: #35040f; font-size: 19px; line-height: 26px;">Next session</h2>
<p style="margin: 0 0 8px;"><%= @next_time ? "The next session is on #{@next_time}." : "Next session time: to be confirmed." %></p>
<p style="margin: 0 0 12px;"><% if @next_meet_url %><a href="<%= @next_meet_url %>" style="color: #a40f32; font-weight: 700; text-decoration: underline;"><%= @skipping_next_session ? "Google Meet link" : "Join on Google Meet" %></a><% else %>The Google Meet link will be available on the session page.<% end %></p>
<% if @skipping_next_session %>
  <p style="margin: 0 0 8px;"><strong>You’re marked as skipping this session.</strong></p>
  <p style="margin: 0 0 8px;"><%= @return_time ? "Your next session is on #{@return_time}." : "Your next session after the ones you’re skipping: to be confirmed." %></p>
  <% if @return_time %>
    <p style="margin: 0 0 12px;"><% if @return_meet_url %><a href="<%= @return_meet_url %>" style="color: #a40f32; font-weight: 700; text-decoration: underline;">Join your return session on Google Meet</a><% else %>The Google Meet link will be available on the session page.<% end %></p>
  <% end %>
<% end %>
<p style="margin: 32px 0 0;">Sincerely yours,<br><strong>Rich and Otto Labot</strong></p>
<img src="cid:<%= @cherry_cid %>" width="80" height="80" alt="The Weekly Builders Cherry: a ruby gem and a red cherry" style="display: block; width: 80px; height: 80px; margin: 16px 0 0; border: 0;">
