<% content_for :preheader, "#{pluralize(@products.size, "product update needs", "product updates need")} review." %>

<%= render "layouts/heading", eyebrow: "Facilitator digest · #{@day.to_fs(:long)}", title: "Product updates need review." %>
<p style="margin: 0 0 16px;"><%= pluralize(@products.size, "product update needs", "product updates need") %> review. The public profiles below are waiting for approval.</p>

<%= render "layouts/button", label: "Open facilitator review queue", url: @url %>

<% @products.each do |product| %>
  <h2 style="margin: 28px 0 6px; color: #35040f; font-size: 19px; line-height: 26px;"><%= product.name %></h2>
  <p style="margin: 0 0 8px; color: #65575a; font-size: 15px; line-height: 23px;"><%= product.created_at.to_date == @day ? "Created" : "Updated" %> · <strong><%= product.user.name.presence || product.user.email %></strong></p>
  <% if product.url.present? %>
    <p style="margin: 0 0 6px;"><%= link_to "Open #{product.name}", product.url, style: "color: #a40f32; text-decoration: underline;" %></p>
  <% end %>
  <p style="margin: 0 0 12px;"><%= link_to "Review #{product.user.name.presence || product.user.email}’s profile", facilitator_profile_reviews_url(anchor: "builder-#{product.user_id}"), style: "color: #a40f32; text-decoration: underline;" %></p>
<% end %>
