<% content_for :preheader, "#{@user.email} is now #{@status.humanize}." %>

<%= render "layouts/heading", eyebrow: "Facilitator update", title: "Enrollment changed." %>
<p style="margin: 0 0 24px; color: #4f3d40; font-size: 16px; line-height: 26px;">A builder’s enrollment status changed.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#fffaf6" style="width: 100%; border: 1px solid #ead8d5; background-color: #fffaf6;">
  <tr>
    <td style="padding: 18px 20px; border-bottom: 1px solid #ead8d5; color: #715f62; font-size: 12px; line-height: 18px; text-transform: uppercase; letter-spacing: 1px;">Builder</td>
    <td align="right" style="padding: 18px 20px; border-bottom: 1px solid #ead8d5; color: #24181a; font-size: 14px; line-height: 20px; font-weight: 700;"><%= @user.email %></td>
  </tr>
  <tr>
    <td style="padding: 18px 20px; color: #715f62; font-size: 12px; line-height: 18px; text-transform: uppercase; letter-spacing: 1px;">New status</td>
    <td align="right" style="padding: 18px 20px; color: #7d0b25; font-size: 14px; line-height: 20px; font-weight: 700;"><%= @status.humanize %></td>
  </tr>
</table>
