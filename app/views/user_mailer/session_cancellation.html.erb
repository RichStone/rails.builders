<% content_for :preheader, "#{@session_date.strftime('%A')} is canceled. Your side project gets some bonus building time." %>
<%= render "layouts/heading", eyebrow: "Session update · #{@session_date.strftime('%-d %B')}", title: "Session canceled." %>
<p style="margin: 0 0 16px;">Hey <%= @recipient_name %>,</p>
<p style="margin: 0 0 16px;"><%= @session_date.strftime("%A") %>’s Rails Builders session (<%= @session_date.strftime("%-d %B") %>) is canceled. <%= @builder_session.cancellation_reason %></p>
<% if @promise %>
  <p style="margin: 0 0 16px;">You now have more time to work on what you promised:</p>
  <%= render "layouts/promise_quote", text: @promise.body %>
  <p style="margin: 0 0 18px; font-size: 15px; line-height: 23px;"><%= link_to "Your last recorded promise · #{@promise.builder_session.scheduled_starts_at.in_time_zone(@promise.builder_session.time_zone).strftime('%-d %B')}", builder_session_url(@promise.builder_session), style: "color: #a40f32; text-decoration: underline;" %></p>
<% else %>
  <p style="margin: 0 0 16px;">You now have more time to work on your next small win. We don’t have a recorded promise for you yet, so pick something worth showing us.</p>
<% end %>
<%= image_tag attachments["loop-monster-rust-mac.png"].url, width: 280, alt: "A determined Loop Monster hacking on a Rust app on his MacBook.", style: "display: block; width: 100%; max-width: 280px; height: auto; margin: 24px 0 12px; border: 0;" %>
<p style="margin: 0 0 16px;">The Loop Monster is already arguing with the Rust compiler. He calls it progress.</p>
<% if @next_session %>
  <p style="margin: 0 0 16px;">See you <%= @next_session.scheduled_starts_at.in_time_zone(@next_session.time_zone).strftime("%A %-d %B at %H:%M %Z") %>. <%= link_to "Session details", builder_session_url(@next_session), style: "color: #a40f32;" %>.</p>
<% else %>
  <p style="margin: 0 0 16px;">There isn’t another session scheduled yet. <%= link_to "Check Sessions for the next date", builder_sessions_url, style: "color: #a40f32;" %>.</p>
<% end %>
<p style="margin: 24px 0 0;">Sincerely yours,<br>Rich and Otto Labot</p>
