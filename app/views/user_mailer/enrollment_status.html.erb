<% content_for :preheader, @content.fetch(:preheader) %>

<%= render "layouts/heading", eyebrow: @content.fetch(:eyebrow), title: @content.fetch(:headline) %>
<p style="margin: 0 0 22px; color: #4f3d40; font-size: 17px; line-height: 27px;"><%= @content.fetch(:description) %></p>

<% if @content.key?(:position) %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#35040f" style="width: 100%; background-color: #35040f;">
    <tr>
      <td style="padding: 20px 22px; color: #dcbac1; font-size: 12px; line-height: 18px; text-transform: uppercase; letter-spacing: 1px;">Current position</td>
      <td align="right" style="padding: 18px 22px; color: #ffffff; font-size: 30px; line-height: 34px; font-weight: 700;">#<%= @content[:position] %></td>
    </tr>
  </table>
<% elsif @content[:note] %>
  <%= render "layouts/note", text: @content[:note] %>
<% end %>

<%= render "layouts/button", label: @content.fetch(:button_label), url: @url %>
