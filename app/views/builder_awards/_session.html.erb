<% if awards.any? || (session_operator? && builder_session.state != "cancelled") %>
  <section class="session-awards" id="<%= local_assigns.fetch(:section_id, "awards") %>">
    <%= render "builder_awards/cards", awards:, speaker_card: false if awards.any? %>
    <% if session_operator? && builder_session.state != "cancelled" %>
      <% if drafts.any? && builder_session.awards_revealable? %>
        <%= button_to "Reveal awards", reveal_builder_session_awards_path(builder_session), method: :patch, params: { version: BuilderAward.draft_version(drafts) }, class: "button button-primary", form: { data: { turbo_confirm: "Reveal all draft awards to the group?" } } %>
      <% end %>
      <details class="session-context-editor" data-award-drafts>
        <summary>🏆 Prepare awards<%= " (#{pluralize(drafts.size, 'draft')})" if drafts.any? %></summary>
        <p>Drafts and evidence are visible only to facilitators and administrators. Reveal shares the citations with Active Builders.</p>
        <% recipients = User.active.where.not(verified_at: nil).order(:name).to_a %>
        <% sources = builder_session.award_source_sessions.order(scheduled_starts_at: :desc).to_a %>
        <% drafts.each do |award| %>
          <details class="session-context-editor">
            <summary><%= award.title %> · <%= session_builder_name(award.user) %></summary>
            <p><%= award.citation %></p>
            <%= render "builder_awards/evidence", award: %>
            <%= render "builder_awards/form", builder_session:, award:, recipients: (recipients | [award.user]), sources: %>
            <%= button_to "Remove draft", builder_session_award_path(builder_session, award), method: :delete, class: "button button-quiet" %>
          </details>
        <% end %>
        <details class="session-context-editor" <%= "open" if drafts.empty? %>>
          <summary>Add an award draft</summary>
          <%= render "builder_awards/form", builder_session:, award: BuilderAward.new, recipients:, sources: %>
        </details>
      </details>
    <% end %>
  </section>
<% end %>
