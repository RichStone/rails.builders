<main class="narrow-page"><p class="eyebrow">Your corner of rails.builders</p><h1>Profile & products</h1><p>Your email <strong><%= current_user.email %></strong> stays private.</p>
  <%= form_with model: current_user, url: profile_path, class: "stacked-form profile-form" do |form| %>
    <%= form.label :name %><%= form.text_field :name, maxlength: 100, placeholder: "Your name" %>
    <%= form.label :avatar, "Bio or company picture" %><%= form.file_field :avatar, accept: "image/png,image/jpeg,image/webp" %>
    <%= form.label :testimonial, "What would you say about Rails Builders?" %><%= form.text_area :testimonial, rows: 4, maxlength: 2000, placeholder: "A short, honest note…" %>
    <fieldset><legend>Focus product</legend><%= fields_for :product, @product do |product_fields| %><%= product_fields.label :name, "App name" %><%= product_fields.text_field :name, maxlength: 120 %><%= product_fields.label :url, "App URL" %><%= product_fields.url_field :url, maxlength: 2048, placeholder: "https://" %><% end %></fieldset>
    <label class="check-row publication"><%= form.check_box :public_profile %><span><strong>Show my profile publicly on rails.builders</strong><small>This publishes your picture, name, testimonial, and product links. Email stays private.</small></span></label>
    <%= form.submit "Save profile", class: "button button-primary" %>
  <% end %>
  <% if current_user.products.any? %><section class="product-list"><h2>All products</h2><% current_user.products.each do |product| %><%= form_with model: product, class: "stacked-form compact-product-form" do |form| %><%= form.label :name, "App name" %><%= form.text_field :name, maxlength: 120 %><%= form.label :url, "App URL" %><%= form.url_field :url, maxlength: 2048 %><div class="button-row"><%= form.submit "Save product", class: "button button-quiet" %><% unless product.focus? %><%= link_to "Make focus", focus_product_path(product), data: { turbo_method: :patch } %><% else %><span class="status-pill">Focus product</span><% end %><%= link_to "Remove", product_path(product), class: "text-danger", data: { turbo_method: :delete, turbo_confirm: "Remove this product?" } %></div><% end %><% end %></section><% end %>
  <section class="product-list"><h2>Add another product</h2><%= form_with model: Product.new, class: "stacked-form" do |form| %><%= form.label :name, "App name" %><%= form.text_field :name, maxlength: 120 %><%= form.label :url, "App URL" %><%= form.url_field :url, maxlength: 2048, placeholder: "https://" %><%= form.submit "Add product", class: "button button-quiet" %><% end %></section>
  <section class="danger-zone"><h2>Delete my account</h2><p>This permanently removes your profile, products, image, seat, and OG card.</p><%= button_to "Delete my account", profile_path, method: :delete, class: "text-danger", data: { turbo_confirm: "Permanently delete your account?" } %></section>
</main>
