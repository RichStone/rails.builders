<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>Rails.Builders</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #ffffff; color: #35292c; font-family: Arial, Helvetica, sans-serif; -webkit-text-size-adjust: 100%;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; mso-hide: all;"><%= content_for?(:preheader) ? yield(:preheader) : "An update from Rails.Builders." %></div>
    <!--[if mso]><table role="presentation" align="center" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
    <table role="presentation" align="center" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width: 100%; max-width: 600px; table-layout: fixed; margin: 0 auto; background-color: #ffffff;">
      <tr>
        <td style="padding: 32px 24px; color: #35292c; font-family: Arial, Helvetica, sans-serif; font-size: 17px; line-height: 27px; word-wrap: break-word;">
          <%= yield %>
          <p style="margin: 32px 0 0; padding-top: 16px; border-top: 1px solid #ead8d5; color: #65575a; font-size: 13px; line-height: 24px;">
            <a href="<%= root_url %>" style="color: #a40f32; font-weight: 700; text-decoration: none;"><span aria-hidden="true">◆</span>&nbsp; Rails.Builders</a>
            <br>Build in public. Ship with <s>Rails</s> Rust?
          </p>
          <p style="margin: 6px 0 0; color: #65575a; font-size: 13px; line-height: 24px;">
            <% unless @account_deleted %>
              <a href="<%= notification_preferences_url %>" style="color: #a40f32; text-decoration: underline;">Configure your notifications</a> &nbsp;·&nbsp;
            <% end %>
            <a href="<%= privacy_url %>" style="color: #a40f32; text-decoration: underline;">Privacy</a>
            &nbsp;·&nbsp; <a href="<%= terms_url %>" style="color: #a40f32; text-decoration: underline;">Terms</a>
            &nbsp;·&nbsp; <a href="mailto:rich@looplabs.cc" style="color: #a40f32; text-decoration: underline;">Email us</a>
          </p>
        </td>
      </tr>
    </table>
    <!--[if mso]></td></tr></table><![endif]-->
  </body>
</html>
