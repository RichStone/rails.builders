<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>Rails Builders</title>
    <style>
      body { margin: 0 !important; padding: 0 !important; width: 100% !important; }
      table { border-collapse: collapse; }
      a { color: #a40f32; }
      @media only screen and (max-width: 620px) {
        .email-wrap { padding: 0 !important; }
        .email-card { border-radius: 0 !important; }
        .email-header { padding: 24px 22px !important; }
        .email-content { padding: 34px 22px 38px !important; }
        .email-footer { padding: 24px 22px 30px !important; }
        .email-title { font-size: 36px !important; line-height: 39px !important; }
        .email-button, .email-button tbody, .email-button tr, .email-button td { width: 100% !important; }
        .email-button a { display: block !important; text-align: center !important; }
        .digest-item { padding: 20px !important; }
      }
    </style>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f7ede6; color: #24181a; font-family: Arial, Helvetica, sans-serif; -webkit-text-size-adjust: 100%;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent; line-height: 1px; font-size: 1px; mso-hide: all;">
      <%= content_for?(:preheader) ? yield(:preheader) : "An update from Rails Builders." %>&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7ede6" style="width: 100%; background-color: #f7ede6;">
      <tr>
        <td class="email-wrap" align="center" style="padding: 32px 16px;">
          <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
          <table class="email-card" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width: 100%; max-width: 600px; overflow: hidden; border: 1px solid #ead8d5; border-radius: 22px; background-color: #ffffff;">
            <tr>
              <td class="email-header" bgcolor="#35040f" style="padding: 28px 38px; background-color: #35040f;">
                <a href="<%= root_url %>" style="display: inline-block; color: #ffffff; font-size: 18px; line-height: 24px; font-weight: 700; text-decoration: none;">
                  <span style="color: #ff6c62; font-size: 15px;">◆</span>&nbsp; Rails Builders
                </a>
                <p style="margin: 6px 0 0; color: #dcbac1; font-size: 12px; line-height: 18px;">Build in public. Ship with Rails.</p>
              </td>
            </tr>
            <tr>
              <td class="email-content" style="padding: 46px 48px 50px;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td class="email-footer" bgcolor="#fffaf6" style="padding: 26px 38px 32px; border-top: 1px solid #ead8d5; background-color: #fffaf6; color: #715f62; font-size: 12px; line-height: 19px;">
                <p style="margin: 0 0 8px; color: #24181a; font-weight: 700;">Rails Builders</p>
                <p style="margin: 0 0 10px;">This transactional message was sent by rails.builders.</p>
                <p style="margin: 0;">
                  <a href="<%= root_url %>" style="color: #7d0b25;">Visit Rails Builders</a>
                  &nbsp;·&nbsp;
                  <a href="<%= privacy_url %>" style="color: #7d0b25;">Privacy</a>
                  &nbsp;·&nbsp;
                  <a href="<%= terms_url %>" style="color: #7d0b25;">Terms</a>
                  &nbsp;·&nbsp;
                  <a href="mailto:rich@looplabs.cc" style="color: #7d0b25;">Email us</a>
                </p>
              </td>
            </tr>
          </table>
          <!--[if mso]></td></tr></table><![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>
