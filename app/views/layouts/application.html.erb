<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Rails Builders — Build in public, ship with Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="A focused Rails builders group for people who want to ship useful products together.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_exempts_page_from_cache_tag if current_user %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="site-header">
      <%= link_to root_path, class: "brand" do %><span class="brand-gem">◆</span> Rails Builders<% end %>
      <nav aria-label="Main navigation">
        <% if current_user %>
          <%= link_to "Dashboard", dashboard_path %>
          <%= link_to "Sessions", builder_sessions_path if session_member? %>
          <%= link_to "Profile", edit_profile_path %>
          <%= link_to "Admin", admin_root_path if current_user.administrator? %>
          <%= link_to "Sign out", sign_out_path, data: { turbo_method: :delete } %>
        <% else %>
          <%= link_to "How it works", root_path(anchor: "how-it-works") %>
          <%= link_to "Meet the builders", root_path(anchor: "builders") %>
          <%= link_to "Join or sign in", sign_in_path, class: "button button-small" %>
        <% end %>
      </nav>
    </header>

    <% flash.each do |type, message| %>
      <div class="flash <%= type %>" role="status"><%= message %></div>
    <% end %>

    <%= yield %>

    <footer class="site-footer">
      <span><span class="brand-gem">◆</span> Rails Builders</span>
      <span>Built with Rails, naturally. 🚂 Forever free, community-led &amp; <%= link_to "https://github.com/RichStone/rails.builders", class: "github-link" do %>open source.<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.64 0 8.13c0 3.59 2.29 6.64 5.47 7.71.4.08.55-.18.55-.39 0-.19-.01-.7-.01-1.38-2.23.49-2.7-1.09-2.7-1.09-.36-.94-.89-1.19-.89-1.19-.73-.5.05-.49.05-.49.81.06 1.23.84 1.23.84.72 1.25 1.88.89 2.34.68.07-.53.28-.89.51-1.09-1.78-.21-3.65-.9-3.65-4.02 0-.89.31-1.61.82-2.18-.08-.21-.36-1.03.08-2.15 0 0 .67-.22 2.2.83A7.5 7.5 0 0 1 8 3.87a7.5 7.5 0 0 1 2 .27c1.53-1.05 2.2-.83 2.2-.83.44 1.12.16 1.94.08 2.15.51.57.82 1.29.82 2.18 0 3.13-1.88 3.81-3.66 4.01.29.25.54.75.54 1.51 0 1.09-.01 1.97-.01 2.24 0 .22.14.47.55.39A8.14 8.14 0 0 0 16 8.13C16 3.64 12.42 0 8 0Z"/></svg><% end %></span>
      <nav class="footer-legal" aria-label="Legal"><%= link_to "Privacy", privacy_path %><%= link_to "Terms", terms_path %></nav>
    </footer>
  </body>
</html>
