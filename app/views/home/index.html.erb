<% content_for :title, "Rails Builders Group — Continuous r-AI-ls.Builders Edition" %>
<% content_for :description, "A focused group of Builders who love ship useful products on Rails." %>

<main>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="live-dot"></span> New continuous cohort · registrations open</p>
      <h1>Build in public with other <em>Rails.Builders</em></h1>
      <p class="hero-lede">A focused group for engineers who build on Rails for their own business. Weekly sessions, momentum, honest feedback, gamification, and fellow devs who notice when you ship. AI-pilled.</p>
      <div class="hero-actions">
        <%= link_to "Claim your place", sign_in_path, class: "button button-primary ruby-burst-button", data: { controller: "ruby-burst", action: "click->ruby-burst#explode" } %>
        <%= link_to "See how it works", "#how-it-works", class: "button button-quiet" %>
      </div>
      <p class="microcopy">Email-only sign in · <%= pluralize(@program.places_left, "place") %> left 🔥</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="ruby ruby-one">◆</div><div class="ruby ruby-two">◆</div><div class="ruby ruby-three">◆</div>
      <div class="code-window"><span>class</span> RailsBuilder<br>&nbsp;&nbsp;<span>def</span> ship<br>&nbsp;&nbsp;&nbsp;&nbsp;idea.<strong>to_product!</strong><br>&nbsp;&nbsp;<span>end</span><br>end<i class="cursor"></i></div>
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
    </div>
  </section>

  <section class="cohort-strip" data-controller="countdown" data-countdown-start-value="<%= @program.starts_on.iso8601 %>" data-countdown-finish-value="<%= @program.ends_on.iso8601 %>">
    <div>
      <p class="eyebrow"><%= @program.started? ? "Current cohort" : "Next cohort" %></p>
      <div class="cohort-name-row">
        <h2><%= @program.name %></h2>
        <details class="info-tip">
          <summary aria-label="About the continuous cohort">i</summary>
          <p>One continuous group, with a shared finish line and new Builders joining when a place opens.</p>
        </details>
      </div>
      <p><%= @program.starts_on.strftime("%d %b") %> — <%= @program.ends_on.strftime("%d %b %Y") %></p>
    </div>
    <div class="countdown" data-countdown-target="display">
      <div><strong data-countdown-target="days">--</strong><span>days</span></div>
      <div><strong data-countdown-target="hours">--</strong><span>hours</span></div>
      <div><strong data-countdown-target="minutes">--</strong><span>mins</span></div>
      <div><strong data-countdown-target="seconds">--</strong><span>secs</span></div>
    </div>
    <p class="countdown-label" data-countdown-target="label"><%= @program.started? ? "until current cohort ends" : "until the new cohort begins" %></p>
  </section>

  <% if @live_session || @upcoming_sessions.any? || @facilitators.any? %>
    <section class="section public-sessions calendar-stage" data-public-sessions>
      <% if @live_session %>
        <div class="live-session-banner">
          <span class="live-signal" aria-hidden="true"></span>
          <div><p class="eyebrow">Live now</p><h2><%= public_session_title(@live_session) %></h2><p>Facilitated by <%= public_session_facilitator_name(@live_session) %></p></div>
        </div>
      <% end %>
      <% if @upcoming_sessions.any? %>
        <div class="section-heading"><p class="eyebrow">On the calendar</p><h2>Build together, on purpose.</h2></div>
        <div class="public-session-grid">
          <% @upcoming_sessions.each do |builder_session| %>
            <article>
              <time datetime="<%= builder_session.scheduled_starts_at.iso8601 %>"><%= builder_session.scheduled_starts_at.in_time_zone(builder_session.time_zone).strftime("%a %d %b · %H:%M %Z") %></time>
              <h3><%= public_session_title(builder_session) %></h3>
              <p>Facilitated by <%= public_session_facilitator_name(builder_session) %></p>
              <span><%= ((builder_session.scheduled_ends_at - builder_session.scheduled_starts_at) / 60).round %> minutes</span>
            </article>
          <% end %>
        </div>
      <% end %>

      <% if @facilitators.any? %>
        <div class="calendar-facilitators">
          <p class="eyebrow">Currently facilitating</p>
          <% @facilitators.each do |facilitator| %>
            <div class="facilitator">
              <div class="portrait">
                <% if facilitator.avatar.attached? %>
                  <%= image_tag facilitator.avatar.variant(resize_to_limit: [800, 800], saver: { strip: true }), alt: facilitator.name %>
                <% else %>
                  <%= facilitator.name.to_s.first || "R" %>
                <% end %>
              </div>
              <div><h2><%= facilitator.name %></h2><p>Working on <%= link_to facilitator.focus_product&.name || "Loop Labs", facilitator.focus_product&.url || "https://looplabs.cc" %>. Keeping the room moving, the ass-kicking candid, and the red thread visible.</p></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section id="how-it-works" class="section how-it-works">
    <div class="section-heading">
      <p class="eyebrow">Not another sprawling community platform</p>
      <h2>How to join</h2>
      <p>Bring one product to focus on. Build alongside fellow devs.</p>
    </div>
    <details class="section-reveal join-reveal">
      <summary class="section-reveal-trigger join-reveal-trigger">
        <span class="reveal-ruby" aria-hidden="true"><i>◆</i><i>◆</i><i>◆</i></span>
        <span><strong>Crack open the build path</strong><small>See all four steps</small></span>
      </summary>
      <div class="steps">
        <article><span>01</span><h3>Join with your email</h3><p>OG builders get first access to the <%= @program.capacity %> seats. Everyone else keeps a place on the waitlist.</p></article>
        <article><span>02</span><h3>Choose the thing you’ll ship</h3><p>Add as many products as you like (hopefully ONE 😉).</p></article>
        <article><span>03</span><h3>Build with company</h3><p>Weekly live sessions where builders share what’s working, learn from each other, and keep shipping.</p></article>
        <article><span>04</span><h3>Keep the context</h3><p>Session history, Slack chat and transcripts keep each conversation available and the learning crisp for useful next moves.</p></article>
      </div>
    </details>
  </section>

  <section class="section benefits">
    <div class="benefit-statement"><span>◆</span><p>Not another feed to scroll.</p><h2>Group principles</h2></div>
    <details class="section-reveal principles-reveal">
      <summary class="section-reveal-trigger principles-reveal-trigger">
        <span><strong>Open the Builders’ code</strong><small>Five things we protect</small></span>
        <span class="reveal-builders" aria-hidden="true"><i>R</i><i>B</i><i>◆</i></span>
      </summary>
      <div class="benefit-list">
        <article><h3>Live contact preferred</h3><p>The meat of being an active Rails Builder is the live sessions—this is where most of the action happens. The rest of the time, we want you to focus on building.</p></article>
        <article><h3>Small by design</h3><p><%= @program.capacity %> active seats keep the room useful, familiar, and accountable.</p></article>
        <article><h3>Your product stays yours</h3><p>Keep your profile private, or publish your work on rails.builders when you’re ready.</p></article>
        <article><h3>Registration never closes</h3><p>Join the queue anytime. When a seat opens, you get 72 hours to make it yours.</p></article>
        <article><h3>Private Slack channel</h3><p>Not the central piece, but it’s there when you want to connect with Rich, ask the group a question, or ask Otto Labot—our robotic Lab Bot—anything about previous sessions or changes to the rails.builders app.</p></article>
      </div>
    </details>
  </section>

  <section class="program-format" data-controller="program-format" data-program-format>
    <div class="format-heading">
      <p class="eyebrow">Proven session format in a gamified cohort.</p>
      <h2>How the <%= @program.name %> works</h2>
      <p>Press the ruby and follow the train.</p>
    </div>
    <div class="format-terminal">
      <div class="format-launcher">
        <button type="button" class="format-play" data-program-format-target="play" data-action="program-format#start" aria-label="Play the Program format">
          <span>◆</span><small>play</small>
        </button>
        <span class="format-launch-track" aria-hidden="true"></span>
      </div>
      <ol class="format-points" aria-live="polite">
        <% @program.format_points_list.each do |point| %>
          <li hidden data-program-format-target="item"><%= point %></li>
        <% end %>
      </ol>
      <div class="format-progress" hidden data-program-format-target="progress" aria-hidden="true"><span>🚂</span></div>
      <%= link_to "I love it 🤝", sign_in_path, class: "button format-handshake", hidden: true, data: { program_format_target: "handshake" } %>
    </div>
  </section>

  <section id="readiness" class="readiness-section">
    <div class="readiness-heading">
      <p class="eyebrow">A quick reality check before you board</p>
      <h2>Am I ready to join?</h2>
      <p>If the direction feels right, but you are missing some of these, you still have time to get them in until the start of the sessions, just get your spot then!</p>
    </div>
    <details class="readiness-reveal">
      <summary aria-label="Open the readiness checklist"><span aria-hidden="true">?</span></summary>
      <div class="readiness-card" data-controller="readiness-checklist">
        <%= render "shared/readiness_points", program: @program %>
        <div class="readiness-effects" data-readiness-checklist-target="effects" aria-hidden="true"></div>
        <div class="readiness-unlock" hidden data-readiness-checklist-target="unlock">
          <p><strong>That’s all you need!</strong> You’re ready to build with the group.</p>
          <%= link_to "Bring me in 🤝", sign_in_path, class: "button button-primary" %>
        </div>
      </div>
    </details>
  </section>

  <section id="builders" class="section builders-section">
    <div class="section-heading"><p class="eyebrow">The people behind the commits</p><h2>Meet the Rails Builders.</h2><p>Profiles appear only when a builder chooses to publish and a facilitator approves. The gleaming rubies are OGs who haven’t stepped into the spotlight yet.</p></div>

    <div id="active-builders" class="builder-group">
      <div class="group-title"><h3>Active Builders</h3><span><%= @active_builders.size %> building now</span></div>
      <div class="builder-grid">
        <% @active_builders.each_with_index do |builder, index| %><%= render "builder_card", builder: builder, index: index %><% end %>
      </div>
    </div>

    <div id="waitlisted-builders" class="builder-group">
      <div class="group-title"><h3>Waitlisted Builders</h3><span><%= @waitlisted_builders.size %> waiting for a seat</span></div>
      <div class="builder-grid">
        <% @waitlisted_builders.each_with_index do |builder, index| %><%= render "builder_card", builder: builder, index: index %><% end %>
      </div>
    </div>

    <div id="og-builders" class="builder-group">
      <div class="group-title"><h3>The OGs</h3><span>They started the spark</span></div>
      <div class="builder-grid">
        <% @og_builders.each_with_index do |builder, index| %><%= render "builder_card", builder: builder, index: index %><% end %>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="ruby-mark">◆</div><p class="eyebrow">Your next commit could use company</p><h2>Come build the thing.</h2><p>One email gets you started. We’ll tell you exactly where you stand.</p><%= link_to "Join Rails Builders", sign_in_path, class: "button button-light" %>
  </section>
</main>
