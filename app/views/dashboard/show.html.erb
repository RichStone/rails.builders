<main class="dashboard-page">
  <div class="dashboard-head"><div><p class="eyebrow">Rails Builders</p>
    <% if current_user.offered? %><h1>Your seat is ready.</h1><p>Confirm by <%= current_user.offer_expires_at.to_fs(:long) %>. Your profile can wait.</p>
    <% elsif current_user.active? %><h1>You’re an active builder.</h1><p>Your seat in <%= @program.name %> is confirmed.</p>
    <% elsif current_user.waitlisted? %><h1>You’re on the waitlist.</h1><p>Your current position is <strong>#<%= current_user.waitlist_position %></strong>. We’ll email you when a seat opens.</p>
    <% elsif current_user.left_waitlist? %><h1>You left the waitlist.</h1><p>You can join the end of the queue again whenever the timing is right.</p>
    <% elsif current_user.removed? %><h1>Your enrollment was removed.</h1><p>An Administrator can restore your eligibility without granting a Seat.</p>
    <% elsif current_user.enrollment_status.in?(%w[declined expired withdrawn]) %><h1>Your seat is open.</h1><p>You’re not currently active or waiting. Join again whenever the timing is right.</p>
    <% else %><h1>Welcome back.</h1><p>Your Rails Builders account is ready.</p><% end %>
  </div><span class="status-pill"><%= current_user.enrollment_status.humanize %></span></div>

  <% if current_user.offered? %><div class="action-panel"><h2>Make it official</h2><p>A pending offer counts toward the <%= @program.capacity %> seats for 72 hours.</p><div class="button-row"><%= button_to "Accept Seat Offer", accept_offer_path, class: "button button-primary" %><%= button_to "Decline", decline_offer_path, class: "button button-quiet" %></div></div><% end %>
  <div class="action-panel"><h2>Your membership</h2><p>Slack access is currently managed manually by the administrator.</p><%= form_with url: membership_path, method: :patch do %><%= hidden_field_tag :active, "0" %><label class="check-row"><%= check_box_tag :active, "1", current_user.active?, disabled: !current_user.active? %><span><strong>Active membership</strong><small><%= current_user.active? ? "Turn this off to withdraw and release your Seat." : "Membership turns on only when you accept a Seat Offer." %></small></span></label><%= submit_tag "Update membership", class: "button button-quiet", data: { turbo_confirm: "Withdraw and release your active Seat?" } if current_user.active? %><% end %></div>
  <% if current_user.waitlisted? || current_user.waitlist_eligible? %><div class="action-panel"><h2>Waitlist</h2><p>You’ll join at the end of the current waitlist.</p><%= form_with url: waitlist_path, method: :patch do %><%= hidden_field_tag :joined, "0" %><label class="check-row"><%= check_box_tag :joined, "1", current_user.waitlisted? %><span><strong>Join the waitlist</strong><small>Turn this off to leave the queue without changing your account.</small></span></label><%= submit_tag "Update waitlist", class: "button button-quiet" %><% end %></div><% end %>

  <div class="dashboard-grid"><section><h2>Your public profile</h2><p><%= profile_visibility_description(current_user) %></p><%= link_to "Edit profile and products", edit_profile_path, class: "button button-quiet" %></section><section><h2><%= @program.name %></h2><p><%= @program.starts_on.to_fs(:long) %> — <%= @program.ends_on.to_fs(:long) %></p><p><%= @program.capacity %> seats · <%= @program.occupied_seats %> reserved</p></section></div>
  <% if current_user.facilitator? %><div class="action-panel"><h2>Profile publication</h2><p>Review builders who have asked to appear publicly.</p><%= link_to "Review profiles", facilitator_profile_reviews_path, class: "button button-quiet" %></div><% end %>
</main>
