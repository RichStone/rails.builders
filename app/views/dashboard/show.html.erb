<main class="dashboard-page">
  <section class="cohort-strip dashboard-program" data-controller="countdown" data-countdown-start-value="<%= @program.countdown_starts_at.iso8601 %>" data-countdown-finish-value="<%= @program.countdown_ends_at.iso8601 %>">
    <div>
      <p class="eyebrow"><%= @program.started? ? "Current program" : "Next program" %></p>
      <h1><%= @program.name %></h1>
      <p class="program-dates"><%= @program.starts_on.strftime("%B %d, %Y") %> — <%= @program.ends_on.strftime("%B %d, %Y") %></p>
      <p class="program-seats"><%= @program.capacity %> seats · <%= @program.occupied_seats %> reserved</p>
      <% if current_user.waitlisted? %>
        <% position = current_user.waitlist_position %>
        <p class="queue-position"><strong>#<%= position %></strong><span>Your current position is <b>#<%= position %></b>. We’ll email you when a seat opens.</span></p>
      <% end %>
    </div>
    <div class="countdown dashboard-countdown" aria-hidden="true">
      <div><strong data-countdown-target="days" data-value="--">--</strong><span>days</span></div>
      <div><strong data-countdown-target="hours" data-value="--">--</strong><span>hours</span></div>
      <div><strong data-countdown-target="minutes" data-value="--">--</strong><span>mins</span></div>
      <div><strong data-countdown-target="seconds" data-value="--">--</strong><span>secs</span></div>
    </div>
    <p class="sr-only" data-countdown-target="accessible">Program countdown loading</p>
    <p class="countdown-label" data-countdown-target="label"><%= @program.started? ? "until current program ends" : "until the program begins" %></p>
  </section>

  <section class="action-panel dashboard-next-steps">
    <% enrollment_step_complete = current_user.active? || current_user.waitlisted? %>
    <% profile_step_complete = current_user.public_profile? %>
    <p class="eyebrow">Your path</p>
    <h2>Next steps</h2>
    <ol>
      <li class="<%= "is-complete" if enrollment_step_complete %>"><span class="next-step-marker" aria-hidden="true"></span><span class="sr-only"><%= enrollment_step_complete ? "Completed" : "Not completed" %></span><div>
        <% if current_user.offered? %>
          <%= link_to "Become an Active Builder", "#membership" %><small>Confirm the readiness promise to take your seat.</small>
        <% elsif current_user.active? %>
          <strong>You’re an Active Builder</strong><small>Your seat is confirmed.</small>
        <% elsif current_user.waitlisted? %>
          <strong>You’re on the waitlist</strong><small>Your queue position is shown above.</small>
        <% elsif current_user.waitlist_eligible? %>
          <%= link_to "Get on the waitlist", "#waitlist" %><small>Complete the readiness promise when you’re ready.</small>
        <% else %>
          <strong>Enrollment is currently unavailable</strong>
        <% end %>
      </div></li>
      <li class="<%= "is-complete" if profile_step_complete %>"><span class="next-step-marker" aria-hidden="true"></span><span class="sr-only"><%= profile_step_complete ? "Completed" : "Not completed" %></span><div><%= link_to(current_user.public_profile? ? "Manage your public profile on rails.builders" : "Make your profile public on rails.builders (if you want to)", edit_profile_path) %><small><%= profile_visibility_description(current_user) %></small></div></li>
    </ol>
  </section>

  <div class="dashboard-head"><div><p class="eyebrow">Rails Builders</p>
    <% if current_user.offered? %><h1>Your seat is ready.</h1><p>Confirm by <%= current_user.offer_expires_at.to_fs(:long) %>. Your profile can wait.</p>
    <% elsif current_user.active? %><h1>You’re an active builder.</h1><p>Your seat in <%= @program.name %> is confirmed.</p>
    <% elsif current_user.waitlisted? %><h1>You’re on the waitlist.</h1><p>You’re in the queue for <%= @program.name %>.</p>
    <% elsif current_user.inactive? %><h1>Your account is ready.</h1><p>Complete the readiness check below when you’re ready to join the waitlist.</p>
    <% elsif current_user.left_waitlist? %><h1>You left the waitlist.</h1><p>You can join the end of the queue again whenever the timing is right.</p>
    <% elsif current_user.removed? %><h1>Your enrollment was removed.</h1><p>An Administrator can restore your eligibility without granting a Seat.</p>
    <% elsif current_user.enrollment_status.in?(%w[declined expired withdrawn]) %><h1>Your seat is open.</h1><p>You’re not currently active or waiting. Join again whenever the timing is right.</p>
    <% else %><h1>Welcome back.</h1><p>Your Rails Builders account is ready.</p><% end %>
  </div><span class="status-pill"><%= current_user.enrollment_status.humanize %></span></div>

  <% if current_user.offered? %><div class="action-panel"><h2>Your turn is open</h2><p>Your pending offer holds one of the <%= @program.capacity %> seats for 72 hours. Complete the readiness check below to claim it.</p><%= button_to "Decline this turn", decline_offer_path, class: "button button-quiet" %></div><% end %>
  <div class="action-panel membership-panel" id="membership">
    <h2>Your membership</h2>
    <% if current_user.offered? || current_user.active? %>
      <%= form_with url: membership_path, method: :patch, data: { controller: "readiness-checklist membership-toggle", readiness_checklist_gated_value: current_user.offered? } do %>
        <div class="membership-activation" <%= "hidden" if current_user.offered? %> data-readiness-checklist-target="activation">
          <%= hidden_field_tag :active, "0" %>
          <label class="check-row membership-switch"><%= check_box_tag :active, "1", current_user.active?, role: "switch", data: { readiness_checklist_target: "choice", membership_toggle_target: "choice", action: "change->readiness-checklist#toggleChoice change->membership-toggle#confirm" } %><span class="membership-switch-control" aria-hidden="true"></span><span><strong>I’m an Active Builder</strong><small>I’m joining the live sessions consistently and building alongside the guys.</small></span></label>
        </div>
        <%= render "toggle_confirmation", id: "membership-confirm", title: current_user.active? ? "Hang up your hard hat?" : "Ready to become an Active Builder?", description: current_user.active? ? "You’ll leave Active Builders and return to civilian life. Your half-finished side projects may miss you—we hope it’s because you made a great exit instead." : "Plot twist: this switch comes with actually showing up and building stuff.", cancel_label: current_user.active? ? "Keep me building" : "Not yet", confirm_label: current_user.active? ? "Leave Active Builders" : "I’m ready — let’s build" %>
        <div class="membership-readiness">
          <h3><%= current_user.active? ? "Keep the readiness promise" : "First, check your readiness" %></h3>
          <p><%= current_user.active? ? "These are the shared ingredients behind the live sessions." : "Your Active Builder checkbox unlocks when every answer is yes." %></p>
          <%= render "shared/readiness_points", program: @program, checkbox_name: "readiness[]" %>
          <div class="readiness-effects" data-readiness-checklist-target="effects" aria-hidden="true"></div>
        </div>
      <% end %>
    <% else %>
      <p>Active Builder status becomes available when you receive a Seat Offer.</p>
    <% end %>
  </div>
  <% if current_user.waitlisted? || current_user.waitlist_eligible? %>
    <div class="action-panel waitlist-panel" id="waitlist" data-waitlist-readiness>
      <h2>Waitlist</h2>
      <%= form_with url: waitlist_path, method: :patch, data: { controller: "readiness-checklist membership-toggle", readiness_checklist_gated_value: !current_user.waitlisted?, readiness_checklist_choice_controls_checkboxes_value: true } do %>
        <div class="membership-activation" <%= "hidden" unless current_user.waitlisted? %> data-readiness-checklist-target="activation">
          <%= hidden_field_tag :joined, "0" %>
          <label class="check-row membership-switch"><%= check_box_tag :joined, "1", current_user.waitlisted?, role: "switch", data: { readiness_checklist_target: "choice", membership_toggle_target: "choice", action: "change->readiness-checklist#toggleChoice change->membership-toggle#confirm" } %><span class="membership-switch-control" aria-hidden="true"></span><span><strong>Join the waitlist</strong><small><%= current_user.waitlisted? ? "Turn this off to leave the queue without changing your account." : "I’m ready for a Seat Offer when my turn comes." %></small></span></label>
        </div>
        <%= render "toggle_confirmation", id: "waitlist-confirm", title: current_user.waitlisted? ? "Give up your spot?" : "Ready to join the waitlist?", description: current_user.waitlisted? ? "You’ll lose position ##{current_user.waitlist_position} in the waitlist. The queue is unlikely to respect “but I was here before.”" : "Plot twist: this switch means you’re ready for a Seat Offer when your turn comes.", cancel_label: current_user.waitlisted? ? "Keep my spot" : "Not yet", confirm_label: current_user.waitlisted? ? "Leave the waitlist" : "Put me on the list" %>
        <div class="membership-readiness">
          <h3><%= current_user.waitlisted? ? "Keep the readiness promise" : "The readiness checklist" %></h3>
          <p><%= current_user.waitlisted? ? "These are the shared ingredients behind the live sessions." : "These are the shared ingredients behind the live sessions. If the direction feels right, but you are missing some of these, you still have time to get them in until the start of the sessions, just get your spot then! Tick them off to join the waitlist." %></p>
          <%= render "shared/readiness_points", program: @program, checkbox_name: "readiness[]" %>
          <div class="readiness-effects" data-readiness-checklist-target="effects" aria-hidden="true"></div>
        </div>
      <% end %>
    </div>
  <% end %>
  <% if current_user.facilitator? %><div class="action-panel"><h2>Profile publication</h2><p>Review builders who have asked to appear publicly.</p><%= link_to "Review profiles", facilitator_profile_reviews_path, class: "button button-quiet" %></div><% end %>
</main>
