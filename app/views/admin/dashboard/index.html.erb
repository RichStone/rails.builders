<main class="admin-page">
  <p class="eyebrow">Control room</p>
  <h1>Rails Builders administration</h1>

  <section class="admin-program">
    <h2><%= @program.name %></h2>
    <%= form_with model: [:admin, @program], class: "inline-form" do |form| %>
      <%= form.label :name %><%= form.text_field :name, maxlength: 100 %>
      <%= form.label :starts_on %><%= form.date_field :starts_on %>
      <%= form.label :ends_on %><%= form.date_field :ends_on %>
      <%= form.label :capacity %><%= form.number_field :capacity, min: 1 %>
      <%= form.label :main_facilitator_id, "Main facilitator" %><%= form.collection_select :main_facilitator_id, User.where(facilitator: true).order(:name, :email), :id, ->(user) { user.name.presence || user.email }, include_blank: "Not assigned" %>
      <label class="check-row"><%= form.check_box :og_priority %><span>OG Priority</span></label>
      <div class="admin-check-with-help">
        <label class="check-row"><%= form.check_box :promotions_paused %><span>Pause waitlist promotion</span></label>
        <details class="info-tip">
          <summary aria-label="About pausing waitlist promotion"><span aria-hidden="true">?</span></summary>
          <p>After you check this and click Update program, people on the waitlist will not receive Seat Offers, even when seats are available. Existing offers and confirmed seats are unchanged, and Promote waitlist does nothing. Uncheck this and update the program to resume promotion. Newly verified OG Builders can still receive direct offers while OG Priority is on.</p>
        </details>
      </div>
      <div class="format-points-field"><%= form.label :format_points, "Session format points (one per line)" %><%= form.text_area :format_points, rows: 10 %></div>
      <div class="format-points-field"><%= form.label :readiness_points, "Builder readiness points (one per line)" %><%= form.text_area :readiness_points, rows: 7 %></div>
      <%= form.submit "Update program", class: "button button-primary" %>
    <% end %>
    <div class="button-row"><%= button_to "Promote waitlist", promote_admin_program_path(@program) %><%= button_to "Expire old offers", expire_offers_admin_program_path(@program) %></div>
    <p><%= @program.occupied_seats %>/<%= @program.capacity %> seats reserved</p>
  </section>

  <section class="calendar-connection">
    <p class="eyebrow">Sessions source of truth</p>
    <h2>Google Calendar</h2>
    <% if @calendar_connection&.status == "connected" %>
      <p><strong><%= @calendar_connection.google_calendar_name %></strong> · <%= @calendar_connection.google_account_email %></p>
      <p>Last synced <%= @calendar_connection.last_synced_at ? time_ago_in_words(@calendar_connection.last_synced_at) + " ago" : "never" %>.</p>
      <div class="button-row"><%= button_to "Sync now", sync_admin_calendar_connection_path, class: "button button-primary" %><%= link_to "Change calendar", admin_calendar_connection_path, class: "button button-quiet" %><%= button_to "Disconnect", admin_calendar_connection_path, method: :delete, class: "button button-quiet", form: { data: { turbo_confirm: "Disconnect the Sessions calendar?" } } %></div>
    <% else %>
      <p>Connect the dedicated secondary calendar owned by the main facilitator. Upcoming sessions will follow it automatically.</p>
      <% if @calendar_connection %><p>Status: <%= @calendar_connection.status.humanize %></p><% end %>
      <div class="button-row"><%= button_to(@calendar_connection ? "Reconnect Google Calendar" : "Connect Google Calendar", admin_calendar_connection_path, class: "button button-primary", form: { data: { turbo: false } }) %></div>
    <% end %>
  </section>

  <section class="admin-builders">
    <div class="group-title"><h2>Builders</h2><span><%= @users.count %> total</span></div>
    <% @builder_groups.each do |status, builders| %>
      <div class="admin-builder-group" data-builder-group="<%= status %>">
        <div class="group-title"><h3><%= status.humanize %></h3><span><%= builders.count %></span></div>
        <div class="admin-builder-grid">
          <% builders.each do |user| %>
            <article class="admin-builder-card">
              <header>
                <div><h4><%= user.name.presence || "Private builder" %></h4><small><%= user.email %></small></div>
                <span class="status-pill"><%= user.enrollment_status.humanize %></span>
              </header>
              <dl>
                <div><dt>Type</dt><dd><%= user_role_labels(user).join(", ") %></dd></div>
                <div><dt>Queue</dt><dd><%= user.waitlist_position || "—" %></dd></div>
                <div><dt>Slack</dt><dd><%= user.slack_status.humanize %></dd></div>
                <div><dt>Newsletter</dt><dd><%= user.clickfunnels_sync_status.humanize %></dd></div>
              </dl>
              <%= link_to "Manage builder →", edit_admin_user_path(user) %>
            </article>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</main>
