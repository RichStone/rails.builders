<main class="admin-page"><p class="eyebrow">Control room</p><h1>Rails Builders administration</h1>
  <section class="admin-program"><h2><%= @program.name %></h2><%= form_with model: [:admin, @program], class: "inline-form" do |form| %><%= form.label :name %><%= form.text_field :name, maxlength: 100 %><%= form.label :starts_on %><%= form.date_field :starts_on %><%= form.label :ends_on %><%= form.date_field :ends_on %><%= form.label :capacity %><%= form.number_field :capacity, min: 1 %><label class="check-row"><%= form.check_box :og_priority %><span>OG Priority</span></label><label class="check-row"><%= form.check_box :promotions_paused %><span>Pause promotion</span></label><%= form.submit "Update program", class: "button button-primary" %><% end %><div class="button-row"><%= button_to "Promote waitlist", promote_admin_program_path(@program) %><%= button_to "Expire old offers", expire_offers_admin_program_path(@program) %></div><p><%= @program.occupied_seats %>/<%= @program.capacity %> seats reserved</p></section>
  <section><div class="group-title"><h2>People</h2><span><%= @users.count %> total</span></div><div class="table-wrap"><table><thead><tr><th>Person</th><th>Type</th><th>Status</th><th>Queue</th><th>Slack</th><th>Newsletter</th><th></th></tr></thead><tbody><% @users.each do |user| %><tr><td><strong><%= user.name.presence || "Private builder" %></strong><small><%= user.email %></small></td><td><%= user_role_labels(user).join(", ") %></td><td><span class="status-pill"><%= user.enrollment_status.humanize %></span></td><td><%= user.waitlist_position %></td><td><%= user.slack_status.humanize %></td><td><%= user.clickfunnels_sync_status.humanize %></td><td><%= link_to "Manage", edit_admin_user_path(user) %></td></tr><% end %></tbody></table></div></section>
</main>
