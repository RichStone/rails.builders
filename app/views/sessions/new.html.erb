<main class="auth-page"><section class="auth-card">
  <p class="eyebrow"><%= @joining ? "Join Rails.Builders" : "Welcome back" %></p><h1>One email. No password.</h1><p>We’ll send a secure link that verifies your address and signs you in.</p>
  <%= form_with url: (@joining ? join_path : sign_in_path), class: "stacked-form", data: (Turnstile.enabled? ? { controller: "turnstile", turnstile_site_key_value: Turnstile.site_key, action: "turbo:before-cache@document->turnstile#beforeCache turbo:submit-end->turnstile#submitted" } : {}) do |form| %>
    <%= form.hidden_field :form_token, value: @form_token %>
    <div hidden aria-hidden="true">
      <%= form.label :website, "Leave this field blank" %>
      <%= form.text_field :website, autocomplete: "off", tabindex: -1 %>
    </div>
    <%= form.label :email, "Email address" %><%= form.email_field :email, value: @user&.email, required: true, autofocus: true, autocomplete: "email", maxlength: 254, placeholder: "you@example.com" %>
    <% if @joining %>
      <label class="check-row"><%= form.check_box :newsletter_opt_in, checked: params[:newsletter_opt_in] == "1" %><span>Yes, email me Rich Steinmetz’s Loop Labs newsletter about Rails, AI engineering, and building software products. <small>Optional. We’ll ask you to confirm separately, and every email includes an unsubscribe link.</small></span></label>
    <% end %>
    <% if Turnstile.enabled? %>
      <div class="turnstile-widget" data-turnstile-target="widget"></div>
      <p data-turnstile-target="status" role="status" aria-live="polite">Checking your browser…</p>
      <button type="button" data-turnstile-target="retry" data-action="turnstile#retry" hidden>Retry verification</button>
      <noscript><p>Please enable JavaScript to verify your browser and sign in.</p></noscript>
    <% end %>
    <%= form.submit "Email me a secure link", class: "button button-primary", disabled: Turnstile.enabled?, data: { turnstile_target: "submit" } %>
  <% end %>
  <p><%= @joining ? link_to("Already have an account? Sign in", sign_in_path) : link_to("New here? Join Rails.Builders", join_path) %></p>
  <p class="fine-print">By continuing, you agree to the <%= link_to "privacy policy", privacy_path %>. Essential Rails.Builders emails are part of operating your account.</p>
</section></main>
