<main class="narrow-page">
  <p class="eyebrow">Builder management</p>
  <h1><%= @builder.name.presence || "Private builder" %></h1>
  <p><%= @builder.email %></p>
  <p><%= link_to "← All Builders", builders_path %><% if current_user.administrator? %> · <%= link_to "Edit full Administrator record", edit_admin_user_path(@builder) %><% end %></p>

  <section class="product-list">
    <h2>Enrollment</h2>
    <p>Status: <strong><%= @builder.enrollment_status.humanize %></strong></p>
    <% if @builder.promotable_to_active? %>
      <%= form_with url: promote_builder_path(@builder), class: "stacked-form", data: { turbo_confirm: "Promote this Builder directly to Active Builder?" } do |form| %>
        <% if @program.calendar_connection&.status == "connected" %>
          <label class="check-row"><%= form.check_box :send_calendar_notification, checked: false %><span><strong>Send a Google Calendar update</strong><small>Optional. Google may notify all guests, not only this Builder.</small></span></label>
        <% elsif @program.calendar_connection %>
          <p>Reconnect Google Calendar before promotion to add this Builder to upcoming sessions.</p>
        <% end %>
        <%= form.button "Promote to Active Builder", class: "button button-primary" %>
      <% end %>
    <% elsif @builder.active? %>
      <p>This Builder is active.</p>
    <% elsif @builder.removed? %>
      <p>Reinstate this Builder before promoting them.</p>
    <% elsif !@builder.verified? %>
      <p>This registration must be verified before promotion.</p>
    <% else %>
      <p>No Seat is available.</p>
    <% end %>
  </section>
</main>
