<% content_for :title, "#{@builder_session.title} — Rails Builders" %>

<main class="session-page <%= "is-live" if @builder_session.active? %>">
  <%= link_to "← All sessions", builder_sessions_path, class: "back-link" %>

  <header class="session-detail-heading">
    <% display_state = { "connection" => "Pre-core", "builder_updates" => "Core session" }.fetch(@builder_session.state, @builder_session.state.humanize) %>
    <p class="eyebrow"><%= display_state %></p>
    <h1><%= @builder_session.title %></h1>
    <p><%= @builder_session.scheduled_starts_at.in_time_zone(@builder_session.time_zone).strftime("%A %d %B · %H:%M %Z") %> · Facilitated by <%= @builder_session.assigned_facilitator&.name || Program.current.main_facilitator&.name || "Rails Builders" %></p>
    <% if @builder_session.description.present? %><p class="session-description"><%= @builder_session.description %></p><% end %>
    <% if @builder_session.location.present? %><p class="session-location"><strong>Location:</strong> <%= @builder_session.location %></p><% end %>
    <% if @builder_session.meeting_code && @builder_session.joinable? %>
      <%= link_to "Join Google Meet", join_builder_session_path(@builder_session), class: "button button-primary", target: "_blank", rel: "noopener noreferrer" %>
      <p class="privacy-note">This meeting may be recorded or transcribed. Private transcripts, AI-generated notes, and trend analysis are retained for Program participants. <%= link_to "Privacy details", privacy_path %>.</p>
    <% end %>
  </header>

  <% if @builder_session.state == "cancelled" %>
    <section class="session-ready-panel">
      <p class="eyebrow">Cancelled on Google Calendar</p>
      <h2>This session is no longer scheduled.</h2>
      <p>The record stays here so the Calendar history remains intact.</p>
    </section>
  <% elsif @builder_session.state == "ready" %>
    <section class="session-ready-panel">
      <h2>Ready when the room is.</h2>
      <p>The Calendar event supplies the core default. Choose each phase before starting.</p>
      <% if session_operator? %>
        <% unless Time.current.between?(@builder_session.scheduled_starts_at - 30.minutes, @builder_session.scheduled_starts_at + 30.minutes) %>
          <p class="form-warning">This is outside the scheduled start window. Starting is still allowed, and a mistaken start can be discarded from the live controls.</p>
        <% end %>
        <%= form_with url: start_builder_session_path(@builder_session), class: "start-session-form", data: { turbo: false } do |form| %>
          <%= form.label :pre_core_minutes, "Pre-core (minutes)" %>
          <%= form.number_field :pre_core_minutes, value: @builder_session.default_pre_core_minutes, min: 0, max: 300, required: true %>
          <%= form.label :duration_minutes, "Core (minutes)" %>
          <%= form.number_field :duration_minutes, value: @builder_session.default_timer_minutes, min: 1, max: 300, required: true %>
          <%= form.label :hangout_minutes, "Hangout (minutes, 0 counts up)" %>
          <%= form.number_field :hangout_minutes, value: @builder_session.default_hangout_minutes, min: 0, max: 300, required: true %>
          <%= form.submit "Start session", class: "button button-primary" %>
        <% end %>
      <% end %>
    </section>

    <section class="attendance-panel">
      <div class="section-heading"><p class="eyebrow">Expected attendance</p><h2>Active Builders</h2></div>
      <ul class="attendance-list">
        <% @builder_session.ready_attendances.each do |attendance| %>
          <% attending = attendance.status == "present" %>
          <li class="attendance-row">
            <div><strong><%= attendance.display_name %></strong><span><%= attending ? "Attending" : "Not attending" %></span></div>
            <% if session_operator? %>
              <%= button_to(attending ? "Mark not attending" : "Confirm attendance", attendance_builder_session_path(@builder_session), method: :patch, params: { user_id: attendance.user_id, status: attending ? "absent" : "present" }, class: "attendance-toggle #{"is-present" if attending}") %>
            <% else %>
              <span class="status-pill"><%= attending ? "Attending" : "Not attending" %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% elsif @builder_session.active? %>
    <% run_token = @builder_session.run_token %>
    <section class="live-session-stage <%= "is-paused" if @builder_session.paused? %>"
      data-controller="session-timer"
      data-session-timer-seconds-value="<%= @builder_session.clock_seconds %>"
      data-session-timer-total-seconds-value="<%= @builder_session.total_remaining_seconds %>"
      data-session-timer-rendered-at-value="<%= (Time.current.to_f * 1000).round %>"
      data-session-timer-mode-value="<%= @builder_session.clock_mode %>"
      data-session-timer-paused-value="<%= @builder_session.paused? %>"
      data-session-timer-heartbeat-url-value="<%= heartbeat_builder_session_path(@builder_session) %>"
      data-session-timer-version-value="<%= @builder_session.updated_at.iso8601(6) %>"
      data-session-timer-state-value="<%= @builder_session.state %>">
      <div aria-live="polite">
        <p class="live-phase"><%= @builder_session.paused? ? "Paused" : display_state %></p>
        <% if @builder_session.state == "builder_updates" && @builder_session.current_speaker_attendance %>
          <h2><%= @builder_session.current_speaker_attendance.display_name %></h2>
          <ol class="session-prompts" data-session-prompts>
            <li>One business challenge</li>
            <li>One AI-building challenge</li>
            <li>What will you have done by the next session?</li>
          </ol>
        <% elsif @builder_session.state == "builder_updates" %>
          <h2>Waiting for an attending Builder.</h2>
        <% elsif @builder_session.state == "connection" %>
          <h2>Welcome in. Start core when the room is ready.</h2>
        <% elsif @builder_session.state == "closing" %>
          <h2>Name the next useful move.</h2>
        <% else %>
          <h2>Hang out. The core session is done.</h2>
        <% end %>
      </div>
      <% clock_label = if @builder_session.state == "hangout" && @builder_session.hangout_duration_seconds.zero?
        "Hangout time elapsed"
      elsif @builder_session.state == "hangout"
        "Hangout time remaining"
      elsif @builder_session.state == "connection"
        "Pre-core time remaining"
      elsif @builder_session.current_speaker_attendance
        "Current speaker time remaining"
      else
        "Core time remaining"
      end %>
      <div class="session-clock" data-session-timer-target="display" role="timer" aria-label="<%= clock_label %>">--:--</div>
      <% if @builder_session.state == "builder_updates" %><p class="total-clock"><span data-session-timer-target="total">--:--</span> core time remains</p><% end %>
    </section>

    <% if session_operator? %>
      <section class="session-controls" data-session-controls>
        <%= button_to(@builder_session.paused? ? "Resume" : "Pause", @builder_session.paused? ? resume_builder_session_path(@builder_session) : pause_builder_session_path(@builder_session), params: { run_started_at: run_token }, class: "button button-quiet", form: { data: { turbo: false } }) %>
        <% if @builder_session.state == "builder_updates" && @builder_session.current_speaker_attendance %><%= button_to "Next", next_speaker_builder_session_path(@builder_session), params: { speaker_id: @builder_session.current_speaker_attendance.id, run_started_at: run_token }, class: "button button-primary" %><% end %>
        <% unless @builder_session.state == "hangout" %>
          <% advance_label = { "connection" => "Start core session", "builder_updates" => "Finish core & start hangout", "closing" => "Start hangout" }.fetch(@builder_session.state) %>
          <% if @builder_session.state == "builder_updates" && @builder_session.unspoken_speakers.any? %>
            <details class="session-confirmation">
              <summary><%= advance_label %></summary>
              <p>This skips every Builder still in the queue.</p>
              <%= button_to "Confirm finish core", advance_builder_session_path(@builder_session), params: { state: @builder_session.state, run_started_at: run_token }, class: "button button-quiet" %>
            </details>
          <% else %>
            <%= button_to advance_label, advance_builder_session_path(@builder_session), params: { state: @builder_session.state, run_started_at: run_token }, class: "button button-quiet" %>
          <% end %>
        <% end %>
        <% if @builder_session.state == "hangout" %>
          <details class="session-confirmation">
            <summary>Finish session</summary>
            <p>This saves the completed session and stops the timer.</p>
            <%= button_to "Confirm finish session", finish_builder_session_path(@builder_session),
              params: { run_started_at: run_token }, class: "button button-quiet" %>
          </details>
        <% end %>
        <details class="session-confirmation cancel-session">
          <summary>Cancel session</summary>
          <p>Only use this for a mistaken start. The timer run will be discarded and this session will return to Ready.</p>
          <%= button_to "Discard session run", cancel_start_builder_session_path(@builder_session),
            params: { run_started_at: run_token },
            class: "button button-quiet", form: { data: { turbo: false } } %>
        </details>
      </section>
    <% end %>

    <% unspoken_speakers = @builder_session.unspoken_speakers.to_a %>
    <% if @builder_session.state == "builder_updates" && unspoken_speakers.any? %>
      <section class="attendance-panel">
        <div class="section-heading"><p class="eyebrow">Coming up</p><h2>Speaker queue</h2></div>
        <%= tag.ol class: "attendance-list speaker-queue",
          data: (session_operator? ? {
            controller: "speaker-order",
            speaker_order_url_value: speaker_order_builder_session_path(@builder_session),
            speaker_order_run_started_at_value: run_token,
            action: "dragover->speaker-order#over drop->speaker-order#drop"
          } : {}) do %>
          <% if session_operator? %><li class="sr-only" data-speaker-order-target="status" aria-live="polite"></li><% end %>
          <% unspoken_speakers.each do |attendance| %>
            <%= tag.li class: "attendance-row",
              draggable: (session_operator? ? "true" : nil),
              data: (session_operator? ? {
                speaker_order_target: "item",
                attendance_id: attendance.id,
                action: "dragstart->speaker-order#start dragend->speaker-order#end"
              } : {}) do %>
              <div><strong><%= attendance.display_name %></strong><span>Up next · <%= format_timer_seconds(attendance.speaker_allotted_seconds) %> allocated</span></div>
              <% if session_operator? %>
                <span class="queue-actions">
                  <button type="button" data-action="speaker-order#earlier" aria-label="Move <%= attendance.display_name %> earlier">↑</button>
                  <button type="button" data-action="speaker-order#later" aria-label="Move <%= attendance.display_name %> later">↓</button>
                  <span class="drag-handle" aria-hidden="true" title="Drag to reorder">↕</span>
                </span>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <section class="attendance-panel">
      <div class="section-heading"><p class="eyebrow">In the room</p><h2>Builders</h2></div>
      <ul class="attendance-list">
        <% @builder_session.attendances.order(Arel.sql("CASE role WHEN 'facilitator' THEN 0 ELSE 1 END"), :speaker_position, :display_name).each do |attendance| %>
          <li class="attendance-row">
            <div><strong><%= attendance.display_name %></strong><span><%= attendance.role.humanize %> · <%= attendance.status.humanize %><%= " · #{attendance.speaker_state.humanize}" if attendance.speaker_state %></span></div>
            <% if session_operator? %>
              <%= button_to(attendance.status == "present" ? "Mark absent" : "Mark present", attendance_builder_session_path(@builder_session), method: :patch, params: { user_id: attendance.user_id, status: attendance.status == "present" ? "absent" : "present", run_started_at: run_token }, class: "attendance-toggle #{"is-present" if attendance.status == "present"}") if attendance.user_id %>
            <% else %>
              <span class="status-pill"><%= attendance.status.humanize %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% elsif @builder_session.state == "completed" %>
    <section class="session-complete-panel">
      <p class="eyebrow">Session complete</p>
      <h2><%= @builder_session.facilitator_name_snapshot %> kept the room moving.</h2>
      <% attendee_count = @builder_session.attendances.where(status: "present").count %>
      <% core_duration_minutes = @builder_session.core_duration_minutes %>
      <p><%= pluralize(attendee_count, "attendee") %> · <%= core_duration_minutes < 1 ? "under 1 minute of core session" : "#{core_duration_minutes}-minute core session" %></p>
      <% if session_operator? %>
        <%= form_with url: timing_builder_session_path(@builder_session), method: :patch, class: "start-session-form" do |form| %>
          <% zone = ActiveSupport::TimeZone[@builder_session.time_zone] %>
          <%= form.label :started_at, "Actual start time" %>
          <%= form.datetime_local_field :started_at,
            value: @builder_session.started_at.in_time_zone(zone).strftime("%Y-%m-%dT%H:%M:%S"),
            step: 1,
            required: true %>
          <%= form.label :ended_at, "Actual end time" %>
          <%= form.datetime_local_field :ended_at,
            value: @builder_session.ended_at.in_time_zone(zone).strftime("%Y-%m-%dT%H:%M:%S"),
            step: 1,
            required: true %>
          <%= form.submit "Correct session times", class: "button button-quiet" %>
        <% end %>
      <% end %>
    </section>

    <section class="attendance-panel">
      <div class="section-heading"><p class="eyebrow">Attendance record</p><h2>Who was there</h2></div>
      <ul class="attendance-list">
        <% @builder_session.attendances.order(Arel.sql("CASE role WHEN 'facilitator' THEN 0 ELSE 1 END"), :display_name).each do |attendance| %>
          <li class="attendance-row">
            <div><strong><%= attendance.display_name %></strong><span><%= attendance.role.humanize %> · <%= attendance.status.humanize %></span></div>
            <% if session_operator? && attendance.user_id %>
              <%= button_to(attendance.status == "present" ? "Mark absent" : "Mark present", attendance_builder_session_path(@builder_session), method: :patch, params: { user_id: attendance.user_id, status: attendance.status == "present" ? "absent" : "present" }, class: "attendance-toggle #{"is-present" if attendance.status == "present"}") %>
            <% else %>
              <span class="status-pill"><%= attendance.status.humanize %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <% transcript = @builder_session.transcript %>
    <% if transcript&.state == "ready" %>
      <section class="session-record">
        <section class="session-analysis-panel" data-session-analysis>
          <div class="section-heading"><p class="eyebrow">The useful signal</p><h2>Session analysis</h2></div>
          <% if transcript.session_analysis.present? %>
            <div class="session-markdown session-analysis-content" data-session-analysis-content><%= render_session_markdown(transcript.session_analysis) %></div>
          <% else %>
            <p class="session-artifact-empty">Analysis has not been added yet.</p>
          <% end %>

          <% if session_operator? %>
            <details class="session-context-editor">
              <summary>Edit notes and analysis</summary>
              <%= form_with scope: :transcript, url: builder_session_transcript_path(@builder_session), method: :patch do |form| %>
                <%= form.label :summary_notes, "Summary notes (Markdown)" %>
                <%= form.text_area :summary_notes, value: transcript.summary_notes, rows: 8, maxlength: 1.megabyte %>
                <%= form.label :session_analysis, "Session analysis (Markdown)" %>
                <%= form.text_area :session_analysis, value: transcript.session_analysis, rows: 14, maxlength: 1.megabyte %>
                <%= form.submit "Save session analysis", class: "button button-primary" %>
              <% end %>
            </details>
          <% end %>
        </section>

        <details class="session-artifact-panel" data-session-notes>
          <summary><span><small>Wispr Flow</small>Summary notes</span><strong aria-hidden="true">+</strong></summary>
          <% if transcript.summary_notes.present? %>
            <div class="session-markdown" data-session-notes-content><%= render_session_markdown(transcript.summary_notes) %></div>
          <% else %>
            <p class="session-artifact-empty">Summary notes have not been added yet.</p>
          <% end %>
        </details>

        <details class="session-artifact-panel" data-session-transcript>
          <summary><span><small>Verbatim record</small>Transcript</span><strong aria-hidden="true">+</strong></summary>
          <div class="session-transcript" data-session-transcript-content><%= simple_format(h(transcript.content)) %></div>
        </details>

        <% if current_user.administrator? %>
          <%= button_to "Delete transcript", builder_session_transcript_path(@builder_session), method: :delete, class: "button button-quiet session-record-delete", form: { data: { turbo_confirm: "Permanently delete this transcript, notes, and analysis?" } } %>
        <% end %>
      </section>
    <% else %>
      <section class="transcript-panel"
        <% if transcript&.state.in?(%w[pending processing]) %>
          data-controller="session-refresh"
          data-session-refresh-url-value="<%= heartbeat_builder_session_path(@builder_session) %>"
          data-session-refresh-version-value="<%= @builder_session.updated_at.iso8601(6) %>"
        <% end %>>
        <div class="section-heading"><p class="eyebrow">Captured conversation</p><h2>Transcript</h2></div>
        <% if transcript&.state == "deleted" %>
          <p>This transcript, its notes, and its analysis were deleted.</p>
        <% elsif transcript&.state == "unavailable" %>
        <div class="transcript-processing">
          <span class="transcript-orbit" aria-hidden="true">◆</span>
          <p><strong>Automatic transcript unavailable</strong></p>
          <p>Google did not make a transcript available within 24 hours. A facilitator can add the fallback copy.</p>
        </div>
        <%= render "manual_transcript_form", builder_session: @builder_session if session_operator? %>
        <% else %>
          <div class="transcript-processing">
            <span class="transcript-orbit" aria-hidden="true">◆</span>
            <p><strong>Processing transcript</strong></p>
            <p><%= transcript&.processing_tip || BuilderSessionTranscript::PROCESSING_TIPS.first %></p>
          </div>
          <%= render "manual_transcript_form", builder_session: @builder_session if session_operator? %>
        <% end %>
      </section>
    <% end %>
  <% end %>
</main>
